{
  "system": {
    "name": "Jarvis",
    "version": "1.5.2",
    "debug_mode": false,
    "coordinate_system": "native_pixels"
  },

  "voice": {
    "default_voice_id": "af_eric",
    "model_dir": "models",
    "onnx_model_file": "model_fp16.onnx",
    "voice_styles_dir": "models/voices",
    "tokenizer_file": "models/tokenizer.json",
    "config_file": "models/config.json"
  },

  "calibration": {
    "enabled": true,
    "max_applications": 0,
    "max_attempts_per_element": 10,
    "screen_analysis_delay": 2.0,
    "element_detection_confidence": 0.7,
    "save_calibration_data": true,
    "auto_backup_existing_data": true,
    "use_native_coordinates": true,
    "coordinate_system": "native_pixels",
    "calibration_screen": 1
  },

  "screen": {
    "multi_screen_enabled": true,
    "capture_quality": 0.9,
    "use_scaled_coordinates": false,
    "coordinate_conversion": {
      "to_native": {
        "method": "identity",
        "factor": 1.0
      },
      "from_native": {
        "method": "identity",
        "factor": 1.0
      }
    }
  },

  "timeout": {
    "ollama_call": 30.0,
    "screen_capture": 5.0,
    "click_delay": 1.5,
    "typing_interval": 0.005
  },

  "predictive": {
    "enabled": true,
    "learning_rate": 0.1,
    "prediction_threshold": 0.7,
    "max_predictions": 3,
    "min_usage_count": 3,
    "pattern_analysis_window": 50,
    "time_window_hours": 24
  },

  "keyboard": {
    "fail_safe_enabled": false,
    "pause_between_actions": 0.05
  },

  "memory": {
    "chat_memory_file": "data/jarvis_memory.json",
    "alias_memory_file": "config/command_aliases.json",
    "max_history_length": 12
  },

  "element_types": {
    "button": {
      "min_width": 80,
      "min_height": 30,
      "confidence_threshold": 0.8,
      "colors": ["#007bff", "#28a745", "#dc3545", "#ffc107"]
    },

    "input_field": {
      "min_width": 200,
      "min_height": 25,
      "confidence_threshold": 0.85,
      "colors": ["#ffffff", "#f8f9fa"]
    },

    "address_bar": {
      "min_width": 300,
      "min_height": 35,
      "confidence_threshold": 0.9,
      "position": "top",
      "colors": ["#ffffff", "#f8f9fa"]
    }
  },

  "chrome": {
    "default_width": 1200,
    "default_height": 800,
    "maximized": false,
    "position": {
      "x": 100,
      "y": 100
    }
  },

  "logging": {
    "level": "WARNING",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "datefmt": "%Y-%m-%d %H:%M:%S",
    "log_file": "logs/jarvis.log"
  }
}
