# =============================================================================
# .gitignore - JARVIS
# Solo se sube lo necesario para instalar y ejecutar JARVIS: codigo, tests,
# configuracion, documentacion, conocimiento estatico y el modelo de voz en uso.
# No se suben datos personales, datos propios de cada equipo, logs ni ficheros
# generados.
# =============================================================================

# --- Datos locales y personales (README_DATA) --------------------------------
# Todo data/ es local (conversaciones, preferencias, calibraciones, inventario
# por machine_id), salvo el conocimiento estatico de data/knowledge/, que JARVIS
# necesita para arrancar.
data/*
!data/knowledge/
data/knowledge/*
!data/knowledge/applications.json
!data/knowledge/capabilities.json
!data/knowledge/entities.json

# --- Logs (se crean al ejecutar) ----------------------------------------------
logs/
*.log

# --- Modelo de voz: solo la variante que usa config.json ---------------------
models/onnx/*.onnx
!models/onnx/model_fp16.onnx
models/gitattributes

# --- Artefactos generados por los tests ---------------------------------------
tests/eyes/fixtures/*.json
tests/eyes/fixtures/*.lock
tests/**/fixtures/_tmp_*

# --- Python y entornos --------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
.env

# --- Cache y pruebas ----------------------------------------------------------
.cache/
.pytest_cache/
.coverage
htmlcov/

# --- Editores y herramientas --------------------------------------------------
.vscode/
.idea/
.supercomplete/
.claude/

# --- Temporales ---------------------------------------------------------------
temp/
temp_*.png
screenshot.png
output.wav
*.tmp
*.bak
*.bak_import

# --- Sistema operativo --------------------------------------------------------
.DS_Store
Thumbs.db

# --- Macros locales de la raiz -------------------------------------------------
macro_mejoraActual.json
macro_recorder.py
macro_runner.py
macro_scheduler.py
