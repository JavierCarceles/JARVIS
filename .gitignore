# =============================================================================
# .gitignore - JARVIS
# Solo se sube lo necesario para instalar y ejecutar JARVIS: codigo, tests,
# configuracion, documentacion, conocimiento estatico y el modelo de voz en uso.
# No se suben datos personales, datos propios de cada equipo, logs ni ficheros
# generados.
# =============================================================================

# --- Logs (se crean al ejecutar) ----------------------------------------------
logs/
*.log

# --- Modelo de voz: solo la variante que usa config.json ---------------------
models/onnx/*.onnx
!models/onnx/model_fp16.onnx
models/gitattributes

# --- Artefactos generados por los tests ---------------------------------------
tests/eyes/fixtures/*.json
tests/eyes/fixtures/*.lock
tests/**/fixtures/_tmp_*

# --- Python y entornos --------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
.env

# --- Cache y pruebas ----------------------------------------------------------
.cache/
.pytest_cache/
.coverage
htmlcov/

# --- Editores y herramientas --------------------------------------------------
.vscode/
.idea/
.supercomplete/
.claude/

# --- Temporales ---------------------------------------------------------------
temp/
temp_*.png
screenshot.png
output.wav
*.tmp
*.bak
*.bak_import

# --- Sistema operativo --------------------------------------------------------
.DS_Store
Thumbs.db

# --- Macros locales de la raiz -------------------------------------------------
macro_mejoraActual.json
macro_recorder.py
macro_runner.py
macro_scheduler.py

# --- Inventario local del equipo (datos personales, varios GB) ----------------
# Incluye la base, sus ficheros -wal/-shm/.bak, la copia descargada de otro
# equipo y los temporales de scripts/bbdd_github.py. La copia completa se guarda
# en la release privada JavierCarceles/JARVIS-datos (ver scripts/bbdd_github.py).
# Solo se sube la muestra pequena de ejemplo.
data/system_inventory*.sqlite3*
!data/system_inventory_sample.sqlite3
data/_bbdd_tmp/
