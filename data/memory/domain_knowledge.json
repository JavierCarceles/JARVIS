{
    "applications": {
        "chrome": {
            "name": "Google Chrome",
            "executable": "chrome.exe",
            "capabilities": [
                "open",
                "navigate", 
                "new_tab",
                "close_tab",
                "back",
                "forward",
                "refresh",
                "zoom_in",
                "zoom_out",
                "zoom_reset"
            ],
            "states": {
                "open": false,
                "active": false,
                "maximized": false,
                "focused": false
            },
            "ui_elements": {
                "address_bar": {
                    "type": "input",
                    "description": "Barra de direcciones del navegador"
                },
                "new_tab_button": {
                    "type": "button", 
                    "description": "Botón para nueva pestaña"
                },
                "refresh_button": {
                    "type": "button",
                    "description": "Botón de actualización"
                },
                "back_button": {
                    "type": "button",
                    "description": "Botón de retroceder"
                },
                "forward_button": {
                    "type": "button",
                    "description": "Botón de avanzar"
                }
            },
            "login_required": false,
            "calibration_needed": ["address_bar", "new_tab_button"]
        },
        "spotify": {
            "name": "Spotify",
            "executable": "spotify.exe",
            "capabilities": [
                "open",
                "play",
                "pause", 
                "next_track",
                "previous_track",
                "search",
                "like_song",
                "create_playlist"
            ],
            "states": {
                "open": false,
                "playing": false,
                "maximized": false,
                "focused": false
            },
            "ui_elements": {
                "search_bar": {
                    "type": "input",
                    "description": "Barra de búsqueda de Spotify"
                },
                "play_button": {
                    "type": "button",
                    "description": "Botón de reproducción/pausa"
                },
                "next_button": {
                    "type": "button",
                    "description": "Botón siguiente canción"
                },
                "previous_button": {
                    "type": "button",
                    "description": "Botón canción anterior"
                }
            },
            "login_required": true,
            "calibration_needed": ["search_bar", "play_button"]
        },
        "vscode": {
            "name": "Visual Studio Code",
            "executable": "code.exe",
            "capabilities": [
                "open",
                "open_file",
                "new_file",
                "save_file",
                "run_code",
                "debug_code",
                "open_terminal",
                "install_extension"
            ],
            "states": {
                "open": false,
                "maximized": false,
                "focused": false
            },
            "ui_elements": {
                "explorer": {
                    "type": "panel",
                    "description": "Panel de explorador de archivos"
                },
                "editor": {
                    "type": "panel",
                    "description": "Panel de editor de código"
                },
                "terminal": {
                    "type": "panel",
                    "description": "Panel de terminal"
                }
            },
            "login_required": false,
            "calibration_needed": []
        },
        "obs_studio": {
            "name": "OBS Studio",
            "executable": "obs64.exe",
            "capabilities": [
                "open",
                "start_stream",
                "stop_stream",
                "start_recording",
                "stop_recording",
                "add_source",
                "remove_source",
                "change_scene"
            ],
            "states": {
                "open": false,
                "streaming": false,
                "recording": false,
                "maximized": false
            },
            "ui_elements": {
                "controls": {
                    "type": "panel",
                    "description": "Panel de controles de streaming"
                },
                "sources": {
                    "type": "panel", 
                    "description": "Panel de fuentes"
                },
                "scenes": {
                    "type": "panel",
                    "description": "Panel de escenas"
                }
            },
            "login_required": false,
            "calibration_needed": ["controls"]
        }
    },
    "categories": {
        "web_browser": {
            "name": "Navegador web",
            "description": "Aplicaciones para navegación por internet",
            "applications": ["chrome"]
        },
        "music": {
            "name": "Reproductor de música",
            "description": "Aplicaciones para reproducción de música",
            "applications": ["spotify"]
        },
        "development": {
            "name": "Herramientas de desarrollo",
            "description": "Aplicaciones para programación y desarrollo",
            "applications": ["vscode"]
        },
        "streaming": {
            "name": "Software de streaming",
            "description": "Aplicaciones para streaming y grabación",
            "applications": ["obs_studio"]
        }
    },
    "common_actions": {
        "open": {
            "description": "Abrir una aplicación",
            "required_parameters": ["application_name"],
            "optional_parameters": []
        },
        "close": {
            "description": "Cerrar una aplicación",
            "required_parameters": ["application_name"],
            "optional_parameters": []
        },
        "navigate": {
            "description": "Navegar a una URL",
            "required_parameters": ["url"],
            "optional_parameters": ["application_name"]
        },
        "type": {
            "description": "Escribir texto",
            "required_parameters": ["text"],
            "optional_parameters": ["target_element"]
        },
        "click": {
            "description": "Hacer clic en un elemento",
            "required_parameters": ["element"],
            "optional_parameters": ["application_name"]
        }
    }
}